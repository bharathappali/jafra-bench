# Renaissance benchmark defaults (sourced by deploy/build scripts).
# Version must match the renaissance/ submodule tag (currently v0.16.1).

BENCHMARK_NAME="renaissance"
CONTAINER_NAME="renaissance"

# Submodule-relative version string including leading 'v'.
RENAISSANCE_VERSION="${RENAISSANCE_VERSION:-v0.16.1}"

# Full image tag for the movie-lens / Jafra stress build.
# Result: quay.io/bharathappali/jafra-bench:renaissance-movie-lens-jafra-v0.16.1
# Override with --image-tag or IMAGE_TAG=...
IMAGE_TAG="${IMAGE_TAG:-renaissance-movie-lens-jafra-v0.16.1}"

# Legacy prefix used only when IMAGE_TAG is unset.
IMAGE_TAG_PREFIX="renaissance_"

# Default: movie-lens jafra-stress config (heavier ALS + Spark memory knobs).
BENCHMARKS="${BENCHMARKS:-movie-lens}"
RENAISSANCE_ARGS="${RENAISSANCE_ARGS:--c jafra-stress -r 1 --scratch-base /tmp/renaissance-scratch}"
# Modest heap so Spark fraction + ALS work creates GC pressure without OOM.
JAVA_OPTS="${JAVA_OPTS:--Xms1g -Xmx2g}"

# Kubernetes Job
JOB_NAME="${JOB_NAME:-renaissance-bench}"
CPU_REQUEST="${CPU_REQUEST:-1}"
CPU_LIMIT="${CPU_LIMIT:-2}"
MEMORY_REQUEST="${MEMORY_REQUEST:-2Gi}"
MEMORY_LIMIT="${MEMORY_LIMIT:-4Gi}"
ACTIVE_DEADLINE_SECONDS="${ACTIVE_DEADLINE_SECONDS:-3600}"

# Jafra opt-in (required labels/annotations applied in job.yaml)
JAFRA_LOOP="${JAFRA_LOOP:-5m}"
JAFRA_JFRSYNC="${JAFRA_JFRSYNC:-default}"
