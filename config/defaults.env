# Shared defaults for jafra-bench deployments.
# Benchmark-specific values live under benchmarks/<name>/benchmark.env

IMAGE_REGISTRY="${IMAGE_REGISTRY:-quay.io/bharathappali}"
IMAGE_REPOSITORY="${IMAGE_REPOSITORY:-jafra-bench}"

# Multi-arch build defaults (podman preferred; docker fallback)
IMAGE_PLATFORMS="${IMAGE_PLATFORMS:-linux/amd64,linux/arm64}"
IMAGE_PUSH="${IMAGE_PUSH:-false}"
# Optional override: CONTAINER_ENGINE=podman|docker
BUILDX_BUILDER_NAME="${BUILDX_BUILDER_NAME:-jafra-bench-multiarch}"

NAMESPACE="${NAMESPACE:-jafra-bench}"
KIND_CLUSTER_NAME="${KIND_CLUSTER_NAME:-jafra}"

# Jafra platform (assumed pre-installed)
JAFRA_SYSTEM_NAMESPACE="${JAFRA_SYSTEM_NAMESPACE:-jafra-system}"
JAFRA_CONTROLLER_DEPLOYMENT="${JAFRA_CONTROLLER_DEPLOYMENT:-jafra-controller}"

# Project ownership labels
PART_OF_LABEL="jafra-bench"
